assets/stones/

# ---- Local backups and scratch (patch specs / commit message drafts written to the repo root)
_backup/
/_*.json
/_*.txt

# ---- OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/

# ---- Library PDFs (copyrighted books) stay on disk
assets/library/
