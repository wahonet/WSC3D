# ---- Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ---- Node / Vite / TypeScript
web/node_modules/
web/dist/
web/.vite/
*.tsbuildinfo
npm-debug.log*

# ---- Runtime data: SQLite db, preview/thumb caches, logs (see README section 6)
server/data/

# ---- Model weights (multi-GB; see README section 1 for expected layout under ml/)
ml/

