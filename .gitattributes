# Normalize line endings: LF in the repository and in the working tree,
# except Windows launchers (CRLF); PowerShell also uses a BOM for Windows PowerShell 5.1.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary formats (never diff / never re-encode)
*.png binary
*.jpg binary
*.jpeg binary
*.tif binary
*.tiff binary
*.webp binary
*.db binary
*.pt binary
*.safetensors binary
*.zip binary
